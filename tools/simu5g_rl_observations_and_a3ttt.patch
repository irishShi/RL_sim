+double LtePhyUe::computeMeanRsrp(LteAirFrame *frame, UserControlInfo *lteInfo)
+{
+    std::vector<double> rsrpVector = primaryChannelModel_->getRSRP(frame, lteInfo);
+    if (rsrpVector.empty())
+        return -999.0;
+
+    double rsrp = 0;
+    unsigned int validValues = 0;
+    for (auto value : rsrpVector) {
+        if (!std::isfinite(value))
+            continue;
+        rsrp += value;
+        validValues++;
+    }
+    return validValues == 0 ? -999.0 : rsrp / validValues;
+}
+
+void LtePhyUe::emitRailwayHandoverObservations()
+{
+    emit(uePositionXSignal_, getRadioPosition().x);
+
+    double speed = 0;
+    if (hostModule != nullptr && hostModule->findSubmodule("mobility") != -1) {
+        IMobility *mobility = check_and_cast<IMobility *>(hostModule->getSubmodule("mobility"));
+        speed = mobility->getCurrentVelocity().length();
+    }
+    emit(ueSpeedSignal_, speed);
+    emit(timeSinceLastHandoverSignal_, (simTime() - lastHandoverTime_).dbl());
+
+    if (primaryChannelModel_ == nullptr) {
+        emit(servingRsrpSignal_, -999.0);
+        emit(neighborRsrpSignal_, -999.0);
+        emit(deltaRsrpSignal_, 0.0);
+        emit(bestNeighborCellSignal_, (long)NODEID_NONE);
+        return;
+    }
+
+    LteAirFrame *frame = new LteAirFrame("railwayRsrpObservationFrame");
+    UserControlInfo *cInfo = new UserControlInfo();
+
+    double servingRsrp = -999.0;
+    double neighborRsrp = -999.0;
+    MacNodeId bestNeighborCell = NODEID_NONE;
+
+    for (const auto& enbInfo : binder_->getEnbList()) {
+        if (isNr_ != enbInfo->isNr)
+            continue;
+
+        MacNodeId cellId = enbInfo->id;
+        LtePhyBase *cellPhy = check_and_cast<LtePhyBase *>(
+                enbInfo->eNodeB->getSubmodule("cellularNic")->getSubmodule("phy"));
+        GHz ueCarrierFrequency = primaryChannelModel_->getCarrierFrequency();
+        LteChannelModel *cellChannelModel = cellPhy->getChannelModel(ueCarrierFrequency);
+        if (cellChannelModel == nullptr)
+            continue;
+
+        cInfo->setSourceId(cellId);
+        cInfo->setTxPower(cellPhy->getTxPwr());
+        cInfo->setCoord(cellPhy->getCoord());
+        cInfo->setFrameType(BROADCASTPKT);
+        cInfo->setDirection(DL);
+
+        double rsrp = computeMeanRsrp(frame, cInfo);
+        if (cellId == masterId_)
+            servingRsrp = rsrp;
+        else if (bestNeighborCell == NODEID_NONE || rsrp > neighborRsrp) {
+            bestNeighborCell = cellId;
+            neighborRsrp = rsrp;
+        }
+    }
+
+    delete cInfo;
+    delete frame;
+
+    emit(servingRsrpSignal_, servingRsrp);
+    emit(neighborRsrpSignal_, neighborRsrp);
+    emit(deltaRsrpSignal_, neighborRsrp - servingRsrp);
+    emit(bestNeighborCellSignal_, (long)bestNeighborCell);
+}
+
+void LtePhyUe::handleRailwayA3Handover(MacNodeId sourceId, double sourceRsrp)
+{
+    if (sourceId != masterId_ && sourceRsrp < railwayA3MinNeighborRsrpDb_)
+        return;
+
+    if (masterId_ == NODEID_NONE) {
+        candidateMasterId_ = sourceId;
+        candidateMasterRssi_ = sourceRsrp;
+        binder_->addHandoverTriggered(nodeId_, masterId_, candidateMasterId_);
+        if (!handoverStarter_->isScheduled())
+            scheduleAt(simTime() + railwayA3TimeToTrigger_, handoverStarter_);
+        return;
+    }
+
+    if (sourceId == masterId_) {
+        currentMasterRssi_ = sourceRsrp;
+        if (railwayA3PendingCellId_ != NODEID_NONE && candidateMasterRssi_ - currentMasterRssi_ <= railwayA3HysteresisDb_) {
+            cancelEvent(handoverStarter_);
+            railwayA3PendingCellId_ = NODEID_NONE;
+            binder_->removeHandoverTriggered(nodeId_);
+        }
+        return;
+    }
+
+    if (currentMasterRssi_ <= -900.0)
+        return;
+
+    if (sourceRsrp - currentMasterRssi_ > railwayA3HysteresisDb_) {
+        candidateMasterId_ = sourceId;
+        candidateMasterRssi_ = sourceRsrp;
+        if (railwayA3PendingCellId_ != sourceId || !handoverStarter_->isScheduled()) {
+            cancelEvent(handoverStarter_);
+            railwayA3PendingCellId_ = sourceId;
+            binder_->addHandoverTriggered(nodeId_, masterId_, candidateMasterId_);
+            scheduleAt(simTime() + railwayA3TimeToTrigger_, handoverStarter_);
+        }
+    }
+    else if (railwayA3PendingCellId_ == sourceId) {
+        cancelEvent(handoverStarter_);
+        railwayA3PendingCellId_ = NODEID_NONE;
+        binder_->removeHandoverTriggered(nodeId_);
+    }
+}
