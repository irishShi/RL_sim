+double LtePhyUe::computeMeanSinr(LteAirFrame *frame, UserControlInfo *lteInfo)
+{
+    std::vector<double> sinrVector = primaryChannelModel_->getSINR(frame, lteInfo);
+    if (sinrVector.empty())
+        return -999.0;
+
+    double sinr = 0;
+    unsigned int validValues = 0;
+    for (auto value : sinrVector) {
+        if (!std::isfinite(value))
+            continue;
+        sinr += value;
+        validValues++;
+    }
+    return validValues == 0 ? -999.0 : sinr / validValues;
+}
